# ontology/src/bin/invalid.telora
# A request that cannot produce a complete Plan must fail and must not publish a
# trusted Plan/Query. This request asks for a dimension whose target entity is only
# reachable through a fan-out (grain-expanding) relationship, so safe-path
# selection rejects the whole request. Run with --best-effort to surface the
# diagnostics.

import "@src/fixtures.telora" { knowledge, request_fanout };
import "@src/ontology.telora" { make_query_creator };
import "query-builder/query-builder.telora" { Plan };

let creator = make_query_creator(knowledge);
let plan: Plan = creator(request_fanout);

# Reaching this line would mean an invalid request produced a trusted Plan.
export let output: String = `unexpected success: published plan revision \{plan.revision}`;
