# ontology/src/bin/invalid-conflict.telora
# A request whose measures disagree on grain must fail and publish nothing. The
# conflict request mixes OrderGrain and ItemGrain measures. Run with --best-effort
# to surface the diagnostics.

import "@src/fixtures.telora" { knowledge, request_conflict };
import "@src/ontology.telora" { make_query_creator };
import "query-builder/query-builder.telora" { Plan };

let creator = make_query_creator(knowledge);
let plan: Plan = creator(request_conflict);

# Reaching this line would mean a grain conflict still produced a trusted Plan.
export let output: String = `unexpected success: published plan revision \{plan.revision}`;
