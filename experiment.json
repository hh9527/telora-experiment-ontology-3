{
  "schema": "telora.opencode-cloned-plan/v1",
  "prompts": {
    "start": "请开始实验。",
    "continue": "恢复执行。"
  },
  "environment": {
    "OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX": "128000"
  },
  "permission_preflight": {
    "a1": [
      "./bin/oc-task next a1",
      "./bin/oc-task mark-done a1 qb.rc",
      "./bin/telora run main -C query-builder",
      "./bin/telora run invalid -C query-builder --best-effort",
      "./bin/telora check @test/query-builder.telora -C query-builder",
      "./bin/telora show @bin/main.telora -C query-builder"
    ],
    "a2": [
      "./bin/oc-task next a2",
      "./bin/oc-task mark-done a2 lang-learn-a2.rc",
      "./bin/oc-task mark-done a2 qb-review-a2.rc",
      "./bin/oc-task mark-done a2 edsl.rc",
      "./bin/telora run main -C ontology",
      "./bin/telora run invalid -C ontology --best-effort",
      "./bin/telora check @test/ontology.telora -C ontology",
      "./bin/telora show @bin/main.telora -C ontology"
    ],
    "a3": [
      "./bin/oc-task next a3",
      "./bin/oc-task mark-done a3 lang-learn-a3.rc",
      "./bin/oc-task mark-done a3 qb-review-a3.rc",
      "./bin/oc-task mark-done a3 ent-1-model.rc",
      "./bin/oc-task mark-done a3 ent-1-query-surface.rc",
      "./bin/telora run main -C ent-1",
      "./bin/telora run query-surface -C ent-1",
      "./bin/telora run invalid -C ent-1 --best-effort",
      "./bin/telora check @test/logistics.telora -C ent-1",
      "./bin/telora check @test/query-surface.telora -C ent-1",
      "./bin/telora show @bin/main.telora -C ent-1"
    ],
    "a4": [
      "./bin/oc-task next a4",
      "./bin/oc-task mark-done a4 lang-learn-a4.rc",
      "./bin/oc-task mark-done a4 intent-1.rc",
      "./bin/telora run main -C intent-1",
      "./bin/telora run verify -C intent-1",
      "./bin/telora run invalid -C intent-1",
      "./bin/telora run invalid -C intent-1 --best-effort",
      "./bin/telora check @test/intent.telora -C intent-1",
      "./bin/telora show @bin/main.telora -C intent-1"
    ]
  },
  "metrics": {
    "roles": {
      "a1": {
        "learning_phases": ["language_learning"],
        "work_phase": "implementation",
        "work_files": ["query-builder/src/query_builder.telora"],
        "artifacts": {
          "code": {
            "core": ["query-builder/src/query_builder.telora"],
            "entries": ["query-builder/src/bin/*.telora"],
            "tests": ["query-builder/tests/query-builder.telora"]
          },
          "documents": {
            "docs": [
              "query-builder/QUERY-BUILDER-TUTORIAL.md",
              "query-builder/PUBLIC-CONTRACT.md",
              "query-builder/NOTES.md"
            ]
          }
        }
      },
      "a2": {
        "learning_phases": ["language_learning", "query_builder_draft_review"],
        "work_phase": "implementation",
        "work_files": ["ontology/src/graph.telora"],
        "artifacts": {
          "code": {
            "core": ["ontology/src/graph.telora", "ontology/src/ontology.telora"],
            "entries": ["ontology/src/bin/*.telora"],
            "tests": ["ontology/tests/ontology.telora"]
          },
          "documents": {
            "docs": [
              "ontology/DSL-TUTORIAL.md",
              "ontology/PUBLIC-CONTRACT.md",
              "ontology/NOTES.md"
            ]
          }
        }
      },
      "a3": {
        "learning_phases": ["language_learning", "query_builder_draft_review", "query_builder_final_learning", "edsl_learning"],
        "work_phases": [
          {"name": "modeling", "files": ["ent-1/src/model.telora", "ent-1/src/bin/main.telora"]},
          {"name": "query_surface_design", "files": ["ent-1/src/query.telora", "ent-1/QUERY-DESIGNER-TUTORIAL.md", "ent-1/PUBLIC-QUERY-CONTRACT.md"]}
        ],
        "artifacts": {
          "code": {
            "private_model": ["ent-1/src/model.telora"],
            "public_facade": ["ent-1/src/query.telora"],
            "entries": ["ent-1/src/bin/*.telora"],
            "tests": ["ent-1/tests/*.telora"]
          },
          "documents": {
            "private_docs": ["ent-1/FEEDBACK.md", "ent-1/NOTES.md"],
            "public_docs": ["ent-1/QUERY-DESIGNER-TUTORIAL.md", "ent-1/PUBLIC-QUERY-CONTRACT.md"]
          }
        }
      },
      "a4": {
        "learning_phases": ["language_learning", "public_query_surface_learning"],
        "work_phase": "intent_modeling",
        "work_files": ["intent-1/src/request.telora", "intent-1/src/bin/main.telora"],
        "artifacts": {
          "code": {
            "request": ["intent-1/src/request.telora"],
            "entries": ["intent-1/src/bin/*.telora"],
            "tests": ["intent-1/tests/intent.telora"]
          },
          "documents": {
            "docs": ["intent-1/FEEDBACK.md", "intent-1/NOTES.md"]
          }
        }
      }
    }
  },
  "artifacts": [
    {
      "name": "telora",
      "source": "target/release/telora",
      "to": "bin/telora",
      "build": ["cargo", "build", "--release", "-p", "telora"],
      "mode": "0555"
    },
    {
      "name": "oc-task",
      "source": "tools/opencode_experiment/task_cli.py",
      "to": "bin/oc-task",
      "mode": "0555"
    }
  ],
  "workflow": {
    "schema": "telora.opencode-node-workflow/v1",
    "start_nodes": ["lang.ready", "domain.ready"],
    "finish_node": "intent-1.ready",
    "stop_path": "control/STOP",
    "nodes": [
      {
        "id": "lang.ready",
        "checks": ["bin/telora", "docs/LANG-TUTORIAL.md", "docs/TELORA-CLI.md"]
      },
      {
        "id": "domain.ready",
        "checks": ["query-builder/GOAL.md", "query-builder/DESIGN.md", "query-builder/telora-deps.json", "ontology/GOAL.md", "ontology/DESIGN.md", "ontology/telora-deps.json", "ent-1/GOAL.md", "ent-1/DOMAIN.md", "ent-1/telora-deps.json", "intent-1/GOAL.md", "intent-1/INTENT.md", "intent-1/telora-deps.json"]
      },
      {
        "id": "qb-feedback-a2.feedback",
        "needs": ["qb-review-a2.rc"],
        "observes": "qb.rc"
      },
      {
        "id": "qb-feedback-a3.feedback",
        "needs": ["qb-review-a3.rc"],
        "observes": "qb.rc"
      },
      {
        "id": "qb.rc",
        "role": "a1",
        "needs": ["lang.ready", "domain.ready"],
        "inputs": ["qb-feedback-a2.feedback", "qb-feedback-a3.feedback"],
        "checks": ["query-builder/src/**/*.telora", "query-builder/src/bin/main.telora", "query-builder/src/bin/verify.telora", "query-builder/src/bin/invalid.telora", "query-builder/tests/query-builder.telora", "query-builder/QUERY-BUILDER-TUTORIAL.md", "query-builder/PUBLIC-CONTRACT.md", "query-builder/NOTES.md"]
      },
      {"id": "lang-learn-a2.rc", "role": "a2", "needs": ["lang.ready", "domain.ready"]},
      {"id": "lang-learn-a3.rc", "role": "a3", "needs": ["lang.ready", "domain.ready"]},
      {"id": "lang-learn-a4.rc", "role": "a4", "needs": ["lang.ready", "domain.ready"]},
      {
        "id": "qb-review-a2.rc",
        "role": "a2",
        "needs": ["qb.rc", "lang-learn-a2.rc"],
        "checks": ["ontology/QUERY-BUILDER-FEEDBACK.md"]
      },
      {
        "id": "qb-review-a3.rc",
        "role": "a3",
        "needs": ["qb.rc", "lang-learn-a3.rc"],
        "checks": ["ent-1/QUERY-BUILDER-FEEDBACK.md"]
      },
      {
        "id": "qb.ready",
        "needs": ["qb.rc"]
      },
      {
        "id": "edsl.rc",
        "role": "a2",
        "needs": ["lang.ready", "domain.ready", "qb.ready"],
        "checks": ["ontology/src/**/*.telora", "ontology/src/bin/main.telora", "ontology/src/bin/verify.telora", "ontology/src/bin/invalid.telora", "ontology/tests/ontology.telora", "ontology/DSL-TUTORIAL.md", "ontology/PUBLIC-CONTRACT.md", "ontology/NOTES.md"]
      },
      {"id": "edsl.ready", "needs": ["edsl.rc"]},
      {
        "id": "ent-1-model.rc",
        "role": "a3",
        "needs": ["lang.ready", "domain.ready", "qb.ready", "edsl.ready"],
        "checks": ["ent-1/src/model.telora", "ent-1/src/bin/main.telora", "ent-1/src/bin/verify.telora", "ent-1/src/bin/invalid.telora", "ent-1/tests/logistics.telora", "ent-1/FEEDBACK.md", "ent-1/NOTES.md"]
      },
      {"id": "ent-1-model.ready", "needs": ["ent-1-model.rc"]},
      {
        "id": "ent-1-query-feedback-a4.feedback",
        "needs": ["intent-1.rc"],
        "observes": "ent-1-query-surface.rc"
      },
      {
        "id": "ent-1-query-surface.rc",
        "role": "a3",
        "needs": ["ent-1-model.ready"],
        "inputs": ["ent-1-query-feedback-a4.feedback"],
        "checks": ["ent-1/src/query.telora", "ent-1/src/bin/query-surface.telora", "ent-1/tests/query-surface.telora", "ent-1/QUERY-DESIGNER-TUTORIAL.md", "ent-1/PUBLIC-QUERY-CONTRACT.md"]
      },
      {"id": "ent-1-query-surface.ready", "needs": ["ent-1-query-surface.rc"]},
      {
        "id": "intent-1.rc",
        "role": "a4",
        "needs": ["lang-learn-a4.rc", "ent-1-query-surface.ready"],
        "checks": ["intent-1/src/request.telora", "intent-1/src/bin/main.telora", "intent-1/src/bin/verify.telora", "intent-1/src/bin/invalid.telora", "intent-1/tests/intent.telora", "intent-1/FEEDBACK.md", "intent-1/NOTES.md"]
      },
      {"id": "intent-1.ready", "needs": ["intent-1.rc"]}
    ],
    "tasks": [
      {
        "id": "qb.rc",
        "role": "a1",
        "needs": ["lang.ready", "domain.ready"],
        "inputs": [],
        "outputs": ["query-builder/src/**/*.telora", "query-builder/src/bin/main.telora", "query-builder/src/bin/verify.telora", "query-builder/src/bin/invalid.telora", "query-builder/tests/query-builder.telora", "query-builder/QUERY-BUILDER-TUTORIAL.md", "query-builder/PUBLIC-CONTRACT.md", "query-builder/NOTES.md"],
        "instruction": "完整学习本次发布的 Telora 教程和 CLI，依据 query-builder/GOAL.md 与 DESIGN.md 实现并验证 QueryBuilder。若 control/nodes/qb-feedback-*.feedback 中存在 Host 发布的反馈，必须完整读取、修订并重验；完成全部交付后标记任务完成。"
      },
      {
        "id": "lang-learn-a2.rc",
        "role": "a2",
        "needs": ["lang.ready", "domain.ready"],
        "inputs": [],
        "outputs": [],
        "instruction": "完整学习本次发布的 Telora 教程和 CLI，并阅读 ontology/GOAL.md 与 DESIGN.md。可以用允许的命令探索语言，但此任务不要读取 QueryBuilder 公共交付，也不要开始实现 eDSL。"
      },
      {
        "id": "lang-learn-a3.rc",
        "role": "a3",
        "needs": ["lang.ready", "domain.ready"],
        "inputs": [],
        "outputs": [],
        "instruction": "完整学习本次发布的 Telora 教程和 CLI，并阅读 ent-1/GOAL.md 与 DOMAIN.md。可以用允许的命令探索语言，但此任务不要读取上游公共交付，也不要开始最终建模。"
      },
      {
        "id": "lang-learn-a4.rc",
        "role": "a4",
        "needs": ["lang.ready", "domain.ready"],
        "inputs": [],
        "outputs": [],
        "instruction": "完整学习本次发布的 Telora 教程和 CLI，并阅读 intent-1/GOAL.md 与 INTENT.md。可以用允许的命令探索语言，但不要读取尚未放行的公共查询面，也不要开始构造 Request。"
      },
      {
        "id": "qb-review-a2.rc",
        "role": "a2",
        "needs": ["qb.rc", "lang-learn-a2.rc"],
        "inputs": ["query-builder/QUERY-BUILDER-TUTORIAL.md", "query-builder/PUBLIC-CONTRACT.md"],
        "outputs": ["ontology/QUERY-BUILDER-FEEDBACK.md"],
        "instruction": "完整阅读 QueryBuilder 公共草案，依据 ontology/DESIGN.md 审查 Plan 算子和 profile 能力。把具体缺口或明确的未发现阻断结论写入 ontology/QUERY-BUILDER-FEEDBACK.md；不要开始实现 eDSL。"
      },
      {
        "id": "qb-review-a3.rc",
        "role": "a3",
        "needs": ["qb.rc", "lang-learn-a3.rc"],
        "inputs": ["query-builder/QUERY-BUILDER-TUTORIAL.md", "query-builder/PUBLIC-CONTRACT.md"],
        "outputs": ["ent-1/QUERY-BUILDER-FEEDBACK.md"],
        "instruction": "完整阅读 QueryBuilder 公共草案，依据 ent-1/DOMAIN.md 审查真实领域所需算子和 Plan 形状。把具体缺口或明确的未发现阻断结论写入 ent-1/QUERY-BUILDER-FEEDBACK.md；不要开始最终建模。"
      },
      {
        "id": "edsl.rc",
        "role": "a2",
        "needs": ["qb.ready", "lang-learn-a2.rc"],
        "absorbs": ["qb-review-a2.rc"],
        "inputs": ["query-builder/QUERY-BUILDER-TUTORIAL.md", "query-builder/PUBLIC-CONTRACT.md"],
        "outputs": ["ontology/src/**/*.telora", "ontology/src/bin/main.telora", "ontology/src/bin/verify.telora", "ontology/src/bin/invalid.telora", "ontology/tests/ontology.telora", "ontology/DSL-TUTORIAL.md", "ontology/PUBLIC-CONTRACT.md", "ontology/NOTES.md"],
        "instruction": "学习 QueryBuilder 最终公共交付，依据 ontology/GOAL.md 与 DESIGN.md 实现并验证 EnterpriseKnowledge eDSL。只处理 Host feedback 中明确归属于 eDSL 的项目；完成全部规定验证后标记本任务完成。"
      },
      {
        "id": "ent-1-model.rc",
        "role": "a3",
        "needs": ["qb.ready", "edsl.ready", "lang-learn-a3.rc"],
        "absorbs": ["qb-review-a3.rc"],
        "inputs": ["query-builder/QUERY-BUILDER-TUTORIAL.md", "query-builder/PUBLIC-CONTRACT.md", "ontology/DSL-TUTORIAL.md", "ontology/PUBLIC-CONTRACT.md", "ent-1/FEEDBACK.md"],
        "outputs": ["ent-1/src/model.telora", "ent-1/src/bin/main.telora", "ent-1/src/bin/verify.telora", "ent-1/src/bin/invalid.telora", "ent-1/tests/logistics.telora", "ent-1/FEEDBACK.md", "ent-1/NOTES.md"],
        "instruction": "完整学习 ontology eDSL 的公共教程和契约，依据 ent-1/GOAL.md 与 DOMAIN.md 建立私有 EnterpriseKnowledge，验证合法与非法 Request 的 Plan -> Query 全链路，并更新 FEEDBACK.md 与 NOTES.md。本任务不要提前设计面向 A4 的公共查询面。"
      },
      {
        "id": "ent-1-query-surface.rc",
        "role": "a3",
        "needs": ["ent-1-model.ready"],
        "inputs": ["ent-1/src/model.telora", "ent-1/FEEDBACK.md", "ent-1/NOTES.md", "ent-1-query-feedback-a4.feedback"],
        "outputs": ["ent-1/src/query.telora", "ent-1/src/bin/query-surface.telora", "ent-1/tests/query-surface.telora", "ent-1/QUERY-DESIGNER-TUTORIAL.md", "ent-1/PUBLIC-QUERY-CONTRACT.md"],
        "instruction": "从已经放行的同一份私有 EnterpriseKnowledge 建立公共查询 facade，导出业务 vocabulary、typed Request 与已捕获私有知识的 lower(Request) -> Query，并编写查询设计者可独立使用的教程和契约。用不针对任何隐藏意图的通用 typed Request 入口和测试实际验证 facade。公共交付不得复制第二份领域知识，不得泄漏表、列、alias、join mapping、SQL 片段或模板，也不得读取或猜测 A4 的私有意图。若 Host 发布 ent-1-query-feedback-a4.feedback，完整读取并修订同一交付；完成实际验证后发布本任务。"
      },
      {
        "id": "intent-1.rc",
        "role": "a4",
        "needs": ["lang-learn-a4.rc", "ent-1-query-surface.ready"],
        "inputs": ["ent-1/QUERY-DESIGNER-TUTORIAL.md", "ent-1/PUBLIC-QUERY-CONTRACT.md", "intent-1/FEEDBACK.md"],
        "outputs": ["intent-1/src/request.telora", "intent-1/src/bin/main.telora", "intent-1/src/bin/verify.telora", "intent-1/src/bin/invalid.telora", "intent-1/tests/intent.telora", "intent-1/FEEDBACK.md", "intent-1/NOTES.md"],
        "instruction": "学习已放行的公共查询面，把 INTENT.md 的合法与非法文字意图忠实表达为公共 typed Request，并且只调用公共 lower。严格验证合法 Query 的确定性以及非法请求失败且无部分 Query；记录公共模型的具体歧义、缺口或物理泄漏，不得构造 Plan、SQL 或诊断容器。"
      }
    ]
  },
  "validation": [
    {"name": "query-builder", "cwd": "query-builder", "command": ["../bin/telora", "run", "main"], "required": true},
    {"name": "query-builder-verify", "cwd": "query-builder", "command": ["../bin/telora", "run", "verify"], "required": true},
    {"name": "ontology", "cwd": "ontology", "command": ["../bin/telora", "run", "main"], "required": true},
    {"name": "ontology-verify", "cwd": "ontology", "command": ["../bin/telora", "run", "verify"], "required": true},
    {"name": "enterprise", "cwd": "ent-1", "command": ["../bin/telora", "run", "main"], "required": true},
    {"name": "enterprise-verify", "cwd": "ent-1", "command": ["../bin/telora", "run", "verify"], "required": true},
    {"name": "enterprise-query-surface", "cwd": "ent-1", "command": ["../bin/telora", "run", "query-surface"], "required": true},
    {"name": "intent", "cwd": "intent-1", "command": ["../bin/telora", "run", "main"], "required": true},
    {"name": "intent-verify", "cwd": "intent-1", "command": ["../bin/telora", "run", "verify"], "required": true}
  ],
  "observe": ["query-builder", "ontology", "ent-1", "intent-1"],
  "archive": ["control", ".oc-task", "docs", "query-builder", "ontology", "ent-1", "intent-1", ".opencode", "opencode.json", "experiment.json"]
}
